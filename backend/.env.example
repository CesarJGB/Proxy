AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
VENICE_API_KEY=
PROXY_API_KEY=

# Fija un modelo para poder cambiar de proveedor sin editar Janitor.
# Para Venice: deepseek-v4-1-flash-1017-uncensored
FORCE_MODEL=
OUTPUT_MODE=smart
TRANSLATOR_MODEL=
TRANSLATOR_REASONING_EFFORT=
REASONING_EFFORT=
REASONING_EXCLUDE=true
EMPTY_RESPONSE_RETRY=1
MIN_COMPLETION_TOKENS=0
CORS_ORIGIN=*
LOG_PROMPT_CONTENT=false
